# ------------------------------------------------------------------
# HomeAtlas environment variables
# Copy to .env.local for local development. Never commit real secrets.
# All values below are placeholders.
# ------------------------------------------------------------------

# --- Supabase (required for the app to run) ---
# Project URL (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side (private) Supabase config. Same values as above.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional publishable/merchant key (used for Stripe-style publishable keys if configured).
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- App URLs ---
# Public URL of this Next.js app (used in emails, redirects, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The Framer marketing site (homeatlas.com).
NEXT_PUBLIC_SITE_URL=https://homeatlas.com

# --- Auth ---
# Secret used to sign auth cookies (any strong random string; 32+ chars).
AUTH_SECRET=
# Where Supabase Auth sends users after email verification.
NEXT_PUBLIC_AUTH_CALLBACK_URL=/auth/callback
# Set to "true" to require email verification (default true).
REQUIRE_EMAIL_VERIFICATION=true
# Comma-separated list of allowed OAuth providers.
OAUTH_PROVIDERS=google

# --- Reconstruction provider ---
# One of: simulated | colmap | gaussian-splat (custom). "simulated" is the default
# development adapter and is clearly labelled in the UI.
RECONSTRUCTION_PROVIDER=simulated
# API key for a real reconstruction provider (only needed when not "simulated").
RECONSTRUCTION_API_KEY=
# Base URL for a self-hosted photogrammetry pipeline (COLMAP / nerfstudio).
RECONSTRUCTION_API_URL=

# --- AI providers ---
# One of: simulated | openai | anthropic. "simulated" = clearly labelled dev adapter.
AI_LLM_PROVIDER=simulated
AI_VISION_PROVIDER=simulated
AI_EMBEDDING_PROVIDER=simulated
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model names (defaults are fine).
AI_LLM_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Billing ---
# One of: simulated | stripe. "simulated" = dev adapter.
BILLING_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs overridden per plan (optional; falls back to plan defaults).
STRIPE_PRICE_EXPLORER=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_COLLECTOR=

# --- Background processing ---
# "local" runs an in-process queue + database poller (no external service).
# "trigger.dev" / "inngest" require their credentials below.
PROCESSING_PROVIDER=local
TRIGGER_API_KEY=
TRIGGER_PROJECT_REF=
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Demo / misc ---
# When true, exposes /api/v1/demo/setup to create a clearly-labelled sample home.
# Must be false in production.
DEMO_MODE=false
